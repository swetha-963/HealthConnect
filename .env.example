# ---------------------------------------------------------------- core
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,[::1]
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------ database
# Default is SQLite (no extra config needed). Set DB_ENGINE=postgresql to switch.
DB_ENGINE=sqlite
DB_NAME=healthconnect
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --------------------------------------------------------------- email
# console  -> prints emails to the terminal (default, no credentials needed)
# smtp     -> sends real email through the SMTP settings below
EMAIL_BACKEND=console
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=HealthConnect <no-reply@healthconnect.local>

# ---------------------------------------------------------------- site
SITE_NAME=HealthConnect
SITE_URL=http://127.0.0.1:8000
SUPPORT_EMAIL=support@healthconnect.local
SUPPORT_PHONE=+1 (555) 014-2200
CURRENCY_SYMBOL=$
DELIVERY_FEE=4.99
FREE_DELIVERY_THRESHOLD=50

# ------------------------------------------------- demo admin (seed_data)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@healthconnect.local
DJANGO_SUPERUSER_PASSWORD=admin12345
